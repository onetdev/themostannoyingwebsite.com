    "@maw/config-ts": "workspace:^",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "catalog:",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
