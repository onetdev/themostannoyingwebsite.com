    "qrcode.react": "^4.2.0",
    "react": "catalog:",
    "react-confetti": "^6.4.0",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-use": "^17.6.1",
    "recharts": "catalog:",
