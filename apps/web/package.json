    "@hookform/resolvers": "^6.0.0",
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@maw/content-sdk": "workspace:^",
    "@maw/logger": "workspace:^",
    "@maw/ui-lib": "workspace:^",
    "@maw/utils": "workspace:^",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@sentry/nextjs": "^11.8.0",
    "@tanstack/react-query": "^5.104.4",
    "@vercel/analytics": "^2.0.1",
    "@wrksz/themes": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "colord": "^2.10.0",
    "core-js": "catalog:",
    "countries-and-timezones": "^3.11.0",
    "emittery": "^2.1.0",
    "framer-motion": "catalog:",
    "html-react-parser": "^6.1.8",
    "inversify": "^8.2.3",
    "ky": "catalog:",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "ogl": "^1.0.11",
