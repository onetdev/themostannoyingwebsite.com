{
  "private": true,
  "name": "@maw/web",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean:devtools-workspace && pnpm run build:deployment-meta && pnpm run build:locales && next build",
    "build:metadata": "pnpm run build:deployment-meta && pnpm run build:web-manifest && pnpm run build:locales",
    "build:deployment-meta": "tsx ./scripts/build-deployment-meta.ts",
    "build:devtools-workspace": "tsx ./scripts/build-devtools-workspace.ts",
    "build:locales": "tsx ./scripts/build-locales.ts",
    "build:web-manifest": "tsx ./scripts/build-web-manifest.ts",
    "check-types": "tsc --project tsconfig.json --pretty --noEmit",
    "clean:devtools-workspace": "tsx ./scripts/build-devtools-workspace.ts --remove",
    "dev": "pnpm run build:deployment-meta && pnpm run build:locales && pnpm run build:devtools-workspace && next dev --experimental-https",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "start": "pnpm run build:deployment-meta && next start",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "i18n:compare": "tsx ./scripts/compare-translations.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "catalog:",
