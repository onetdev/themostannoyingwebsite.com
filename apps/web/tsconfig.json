{
  "extends": "@maw/config-ts/configs/next-js.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/root/*": ["./*"]
    },
    "types": ["node", "jest"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
