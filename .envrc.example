export NEXT_PUBLIC_SENTRY_ENABLED=true
export NEXT_PUBLIC_SENTRY_CLIENT_DSN=https://{ID1}@{ID2}.ingest.de.sentry.io/{ID3}
export SENTRY_SERVER_DSN=https://{ID1}@{ID2}.ingest.de.sentry.io/{ID3}
export SENTRY_EDGE_DSN=https://{ID1}@{ID2}.ingest.de.sentry.io/{ID3}

export NEXT_PUBLIC_IS_DEV=true

# Overrides the headless Content API base URL for the app and build scripts.
# Defaults to https://content.themostannoyingwebsite.com when unset.
export NEXT_PUBLIC_CONTENT_API_URL=https://content.themostannoyingwebsite.com

# Uncomment to let `build:locales` write the bundled English-only list instead
# of failing the build when the Content API is unreachable.
# export ALLOW_LOCALES_FALLBACK=true

# Interaction telemetry (see adr/0037-user-interaction-telemetry.md).
# `NEXT_PUBLIC_TELEMETRY_CONSOLE` forces the console sink in production builds;
# `NEXT_PUBLIC_TELEMETRY_DISABLED` mutes the tracker entirely. The beacon stays
# off unless a first-party collector URL is configured.
# export NEXT_PUBLIC_TELEMETRY_CONSOLE=true
# export NEXT_PUBLIC_TELEMETRY_DISABLED=true
# export NEXT_PUBLIC_TELEMETRY_BEACON_URL=https://content.themostannoyingwebsite.com/api/v1/vitals

export ASDF_NODEJS_AUTO_ENABLE_COREPACK=true
